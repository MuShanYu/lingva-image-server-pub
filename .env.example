# Bearer 鉴权 token（USE_STUB=0 时必填；可用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
API_TOKEN=dev-token
# 1 = 不加载模型，返回假数据
USE_STUB=1
MODEL_DIR=./models
# auto / cuda / cpu
DEVICE=auto
MAX_UPLOAD_MB=15
# 同时进行的推理数（install.sh 按 GPU 部署时默认写入 2）
MAX_CONCURRENCY=1
# CTD 检测输入尺寸
DETECT_SIZE=1536
# 气泡检测置信度阈值
BUBBLE_SCORE_MIN=0.3
# 擦字 mask 膨胀像素上限（按原图尺寸）。实际膨胀量 = 块字号 × 0.2，至少 3，不超过此值
MASK_DILATION=30
# 单个修补区域送入 LaMa 的最大边长（512 在 CPU 上快约 40%，但大区域偶有原文残影）
INPAINT_SIZE=1024
# auto / bf16 / fp16 / fp32
INPAINT_PRECISION=auto
# 图片短边低于此值时先超分；0 表示关闭
UPSCALE_MIN_SIDE=0
WEBP_QUALITY=92

# ---- 文档识别（/v1/doc/page、/v1/doc/figure：PDF 扫描页整页 OCR、图片 OCR，见 app/doc/）----
# 总开关。文档模型（PaddleOCR，requirements-doc.txt）与漫画管线装在同一个环境里，以子进程运行；
# 镜像构建时 DOC_PIPELINE=1 才会安装。作为官方托管服务的 GPU 机时，前端和本机都要开启
DOC_PIPELINE_ENABLED=0
# 文档 worker 的 Python，留空 = 与服务相同的解释器
DOC_PYTHON=
# onnxruntime（默认，与漫画管线共用 onnxruntime-gpu）/ paddle_static（需另装 paddlepaddle）
DOC_ENGINE=onnxruntime
# gpu:0 / cpu
DOC_DEVICE=gpu:0
# 输入图片长边上限（像素），超过返回 image_too_large（附 max_side），插件压缩后重试
DOC_MAX_SIDE=2500
# 文字检测输入的长边上限：2500 时检测显存峰值约 3.9G（每次推理后会归还），显存紧张时降到 2000（约 2.5G）
DOC_DET_LIMIT_SIDE=2500
# 单页处理超时（秒），超时返回 timeout 并重启文档 worker；worker 启动（加载模型）超时
DOC_TIMEOUT=30
DOC_START_TIMEOUT=600

# ---- 以下仅 Docker 部署使用（deploy/install.sh 会自动填写）----
# 有域名时填写，并设 COMPOSE_PROFILES=https、LINGVA_BIND=127.0.0.1，由 Caddy 自动申请 HTTPS 证书
LINGVA_SITE=
LINGVA_BIND=0.0.0.0
LINGVA_PORT=8000
COMPOSE_PROFILES=
# 使用 GPU：docker-compose.yml:docker-compose.gpu.yml
COMPOSE_FILE=docker-compose.yml
# 一行命令安装（发布模式）使用的镜像；GPU 用 :cuda 标签
LINGVA_IMAGE=
# 有域名时启用的 Caddy 镜像，留空为 Docker Hub 的 caddy:2；国内模式下 install.sh 改为 ACR 上的同步版本
CADDY_IMAGE=
# 源码构建时 torch 的安装源：CPU 版 .../whl/cpu，GPU 版 .../whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# 或从平铺目录形式的镜像安装固定版本（设置后忽略 TORCH_INDEX_URL），如
#   TORCH_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cu124/  TORCH_VERSION=2.6.0+cu124
TORCH_FIND_LINKS=
TORCH_VERSION=
# 国内镜像（可选）：PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple、HF_ENDPOINT=https://hf-mirror.com
# 必须是 https（wheel 没有签名，靠 TLS 保证完整性），腾讯云：https://mirrors.cloud.tencent.com/pypi/simple
# （阿里云 https 镜像在 ECS 上对 pip 极慢，不建议）
PIP_INDEX_URL=https://pypi.org/simple
# 源码构建时 Debian 软件源镜像（可选）：APT_MIRROR=http://mirrors.aliyun.com（阿里云 ECS 内网：http://mirrors.cloud.aliyuncs.com）
APT_MIRROR=
# GPU 构建设为 1：气泡检测改用 onnxruntime-gpu
ONNXRUNTIME_GPU=0
HF_ENDPOINT=
